{
  "name": "better-auth-prisma-orm",
  "type": "module",
  "version": "0.2.1",
  "description": "A Better Auth adapter for Prisma 8 built with extensions in mind.",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "import": "./dist/client.mjs"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "biome check --write",
    "test": "vitest run",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.contract.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ryangarber/better-auth-prisma-orm.git"
  },
  "keywords": [
    "better-auth",
    "prisma",
    "adapter"
  ],
  "author": "Ryan Garber <ryanmichaelgarber@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@better-auth/core": "^1.7.27",
    "@biomejs/biome": "^2.6.8",
    "@prisma/orm-postgres": "8.0.0-rc.25",
    "@prisma/orm-toolchain": "8.0.0-rc.25",
    "@types/node": "^26.6.6",
    "better-auth": "^1.7.27",
    "prisma-orm-extension-zod": "^0.3.2",
    "temporal-spec": "^1.0.1",
    "tsdown": "^0.23.7",
    "typescript": "7.1.0-beta",
    "vitest": "^5.1.1",
    "zod": "^4.6.7"
  },
  "types": "./dist/index.d.mts",
  "peerDependencies": {
    "@better-auth/core": "^1.4.19",
    "@prisma/orm-postgres": "8.0.0-rc.25"
  },
  "dependencies": {
    "temporal-polyfill": "^1.0.8"
  },
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24 <27",
      "onFail": "download"
    }
  }
}
